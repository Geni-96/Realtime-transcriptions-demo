# Backend configuration for Realtime-transcriptions-demo
# Copy this file to .env and adjust values as needed

# ---- Gemini (cloud) engine ----
# GEMINI_API_KEY=your_api_key_here
# GEMINI_MODEL=gemini-2.0-flash-lite
# GEMINI_API_VERSION=v1beta
# GEMINI_TIMEOUT_MS=30000
# GEMINI_RETRY_BASE_MS=1000
# GEMINI_RETRY_BACKOFF=2
# GEMINI_RETRY_MAX_MS=8000

# ---- Faster Whisper (WebSocket) engine ----
# Point this to your Faster Whisper WS endpoint. Example for local server:
# FASTER_WHISPER_WS_URL=ws://localhost:8000/ws
# Overall timeout when streaming via Faster Whisper (ms)
# FASTER_WHISPER_TIMEOUT_MS=45000
# Small delay before closing the socket after sending last frame (ms)
# FASTER_WHISPER_POST_STREAM_DELAY_MS=200

# HTTP server port for this Node backend
# PORT=3001
